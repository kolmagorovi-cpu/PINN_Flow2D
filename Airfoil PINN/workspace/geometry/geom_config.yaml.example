# ============================================================================
# КОНФИГУРАЦИЯ ГЕОМЕТРИИ (GEOM_CONFIG.YAML)
# ============================================================================
#
# Этот файл используется модулями Geometry.py и Collocation.py для
# автоматической подготовки геометрии для профиля или тройника.
#
# Основные параметры:
#   geom_type: тип геометрии
#     - 'airfoil' - аэродинамический профиль (крыло)
#     - 'junction' - плоский тройник (T-образный, Y-образный)
#
#   geom_name: имя конфигурации из библиотеки
#     - для airfoil: смотри workspace/geometry/foil_geoms.yaml
#     - для junction: смотри Geometry/junction_geoms.yaml
#
# Библиотеки геометрии (фиксированные пути):
#   FOIL_GEOMS_PATH: workspace/geometry/foil_geoms.yaml
#   JUNCTION_GEOMS_PATH: C:\Users\BelchikovDA\projects\dev\proj\pinn-solver\PINN_Flow2D\Airfoil PINN\Geometry\junction_geoms.yaml
#
# ============================================================================

# -----------------------------------------------------------------------------
# ОСНОВНЫЕ ПАРАМЕТРЫ
# -----------------------------------------------------------------------------
geom_type: 'airfoil'
geom_name: 'VMFL063'
# geom_type: 'junction'
# geom_name: 'VMFL010'

# -----------------------------------------------------------------------------
# ПАРАМЕТРЫ ДЛЯ ПРОФИЛЯ (AIRFOIL)
# -----------------------------------------------------------------------------
# Эти параметры используются при geom_type: 'airfoil'
#
# source_type: источник данных (переопределяет значение из YAML-библиотеки)
#   - 'file' - загрузка из файла
#   - 'inline' - встроенные данные
#
# file_path: путь к файлу профиля (для source_type: 'file')
# file_format: формат файла ('csv', 'txt', 'dat', 'npy')
#
# contour_coef: коэффициент масштабирования контура профиля
# x_domain_coef: коэффициент масштабирования длины расчётной области
# y_domain_coef: коэффициент масштабирования высоты расчётной области
#
# domain_params: параметры расчётной области
#   front: длина домена перед профилем [м]
#   rear: длина домена за профилем [м] (для замкнутого профиля)
#   top: высота домена над профилем [м]
#   bottom: высота домена под профилем [м] (для замкнутого профиля)
#
# auto_domain: автоматический расчёт размеров области на основе хорды
# normalize: нормализация координат к хорде (для безразмерных расчётов)

airfoil_params:
  source_type: 'file'              # 'file' или 'inline'
  
  # Для source_type: 'file' раскомментировать:
  file_path: 'workspace/geometry/foils/plate.txt'
  file_format: 'txt'

  contour_coef: 1.0
  x_domain_coef: 1.0
  y_domain_coef: 1.0

  domain_params:
    front: 1.5
    top: 0.5

  auto_domain: true
  normalize: false

# -----------------------------------------------------------------------------
# ПАРАМЕТРЫ ДЛЯ ТРОЙНИКА (JUNCTION)
# -----------------------------------------------------------------------------
# Эти параметры используются при geom_type: 'junction'
#
# source_type: источник данных
#   - 'config' - параметрическое задание
#   - 'file' - загрузка из CAD (на перспективу)
#
# Параметры для source_type: 'config':
#   chanel_width: ширина всех каналов [м]
#   down_length: длина входного канала (нижний) [м]
#   side_length: длина бокового канала (правый) [м]
#   top_length: длина выходного канала (верхний) [м]
#   top2side_angl: угол между верхним и боковым каналами [°]
#   side2down_angl: угол между боковым и нижним каналами [°]

junction_params:
  source_type: 'config'
  
  chanel_width: 1.0
  down_length: 2.0
  side_length: 3.0
  top_length: 3.0
  top2side_angl: 90
  side2down_angl: 90
  
  auto_domain: true
  origin_at_junction: true

# -----------------------------------------------------------------------------
# ОБЩИЕ ПАРАМЕТРЫ
# -----------------------------------------------------------------------------
# Эти параметры применяются к обоим типам геометрии

common_params:
  output_dir: 'workspace/geometry/domains'            # Директория выходных файлов
  save_format: 'npy'                     # Формат сохранения: 'npy', 'csv', 'txt'
  plot_enabled: true                     # Включить визуализацию
  plot_show: true                        # Показывать графики сразу
  plot_dpi: 300                          # DPI для сохранения графиков
  verbose: true                          # Подробный вывод в консоль

# -----------------------------------------------------------------------------
# ПРИМЕРЫ КОНФИГУРАЦИЙ
# -----------------------------------------------------------------------------

# Пример 1: Профиль NACA 0012 из CSV файла
# -----------------------------------------------------------------------------
# geom_type: 'airfoil'
# geom_name: 'NACA0012'
# airfoil_params:
#   source_type: 'file'
#   file_path: 'workspace/geometry/foils/naca0012.csv'
#   file_format: 'csv'
#   domain_params:
#     front: 0.5
#     top: 0.3


# Пример конфигурационного файла для PINN Flow2D
# Скопируйте этот файл в config.yaml и настройте параметры под свою задачу

# =============================================================================
# ПАРАМЕТРЫ ДАННЫХ
# =============================================================================
data_paths:
  points_file: null          # Путь к файлу с точками коллокации (например, Collocation/Data/collocation_points.npy)

# =============================================================================
# АРХИТЕКТУРА НЕЙРОННОЙ СЕТИ
# =============================================================================
model_params:
  layers:                    # Количество нейронов в скрытых слоях
    - 50
    - 50
    - 50
    - 50
  use_boundary_encoding: true  # Использовать ли кодирование границ

# Смещение выходного слоя (u0, v0, p0) - инициализация начальных значений
output_bias: !!python/tuple
  - 0.1
  - 0.0
  - 0.1

# =============================================================================
# ПАРАМЕТРЫ ОБУЧЕНИЯ
# =============================================================================
epochs: 2000                 # Общее количество эпох обучения
batch_size: 1200             # Размер батча
gradient_accumulation_steps: 50  # Накопление градиентов (для эффективного использования памяти)

# =============================================================================
# ОПТИМИЗАТОР
# =============================================================================
optimizer_params:
  lr: 0.001                  # Learning rate для Adam

use_lbfgs: false             # Переключиться на L-BFGS после Adam (для точной доводки)

# =============================================================================
# ДВУХЭТАПНОЕ ОБУЧЕНИЕ
# =============================================================================
two_stage: true              # Включить двухэтапное обучение
stage1_epochs: 100           # Количество эпох первого этапа (только BC)
stage2_pde_weight_start: 1.0 # Начальный вес PDE на втором этапе
stage2_pde_weight_end: 10000.0  # Конечный вес PDE
stage2_ramp_epochs: 500      # Количество эпох для нарастания веса PDE

# =============================================================================
# ВЕСА ФУНКЦИИ ПОТЕРЬ
# =============================================================================
loss_weights:
  # PDE уравнения
  cont: 1.0                  # Неразрывность
  mom_x: 1.0                 # Импульс по X
  mom_y: 1.0                 # Импульс по Y
  
  # Граничные условия
  inlet: 5000.0              # Вход
  outlet: 5000.0             # Выход
  wall: 5000.0               # Стенка (профиль)
  symmetry: 5000.0           # Симметрия
  axis_symmetry: 5000.0      # Осевая симметрия
  symmetry_grad: 5000.0      # Градиент на симметрии
  axis_symmetry_grad: 5000.0 # Градиент на осевой симметрии

# =============================================================================
# АДАПТИВНЫЕ ВЕСА (Self-Adaptive PINN)
# =============================================================================
use_sa_weights: false        # Использовать адаптивные веса точек
sa_apply_to_bc: true         # Применять SA-веса к граничным условиям
sa_lr: 0.001                 # Learning rate для SA-весов
adaptive_weights: false      # Адаптивная балансировка весов

# =============================================================================
# ИНТЕГРАЛЬНОЕ УСЛОВИЕ
# =============================================================================
integral_condition: true     # Включить интегральное условие (баланс масс)
integral_weight: 1000000.0   # Вес интегрального условия

# =============================================================================
# RAR (Residual Adaptive Refinement)
# =============================================================================
rar_enable: false            # Включить адаптивное добавление точек
reset_interval: 0            # Интервал сброса оптимизатора (0 = отключено)

# =============================================================================
# УСТРОЙСТВО И ТОЧНОСТЬ
# =============================================================================
device: auto                 # 'cpu', 'cuda', или 'auto'
num_gpus: 1                  # Количество используемых GPU
dtype: float32               # 'float32' или 'float64'
use_amp: true                # Автоматическое смешивание точностей (AMP)

# =============================================================================
# ВИЗУАЛИЗАЦИЯ И СОХРАНЕНИЕ
# =============================================================================
plot_frequency: 1            # Частота обновления графиков (в эпохах)
checkpoint_dir: Checkpoints  # Директория для чекпоинтов
checkpoint_interval: 100     # Интервал сохранения чекпоинтов (в эпохах)

# =============================================================================
# ИНТЕРАКТИВНЫЙ РЕЖИМ
# =============================================================================
enable_key_listener: true    # Включить горячие клавиши (Ctrl+P, Ctrl+W, Ctrl+R...)

# =============================================================================
# ТИП ТЕЧЕНИЯ
# =============================================================================
flow_type: symmetry          # 'symmetry' или 'axisymmetric'

# =============================================================================
# ОБРЕЗКА ГРАДИЕНТОВ
# =============================================================================
grad_clip: null              # Максимальная норма градиента (null = отключено)
